# Public API base URL (optional: production is the application's fallback)
EXPO_PUBLIC_API_URL=https://api-mangaka.novaproj.site

# Optional while backend reCAPTCHA verification is disabled. When verification
# is enabled, the origin must be registered for the same v3 site key.
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=
EXPO_PUBLIC_RECAPTCHA_ORIGIN=
